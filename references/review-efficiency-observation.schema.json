{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review efficiency observation",
  "type": "object",
  "required": ["participant_id", "condition", "task_id", "order", "metrics", "quality"],
  "properties": {
    "participant_id": {"type": "string", "minLength": 1},
    "condition": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1},
    "metrics": {
      "type": "object",
      "required": ["first_understanding_ms", "annotation_location_ms", "click_count"],
      "properties": {
        "first_understanding_ms": {"type": "integer", "minimum": 0},
        "annotation_location_ms": {"type": "integer", "minimum": 0},
        "click_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["misunderstanding_count", "omission_count", "conflict_count", "locatability"],
      "properties": {
        "misunderstanding_count": {"type": "integer", "minimum": 0},
        "omission_count": {"type": "integer", "minimum": 0},
        "conflict_count": {"type": "integer", "minimum": 0},
        "locatability": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
