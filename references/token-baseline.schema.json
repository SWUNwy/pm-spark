{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic proxy token baseline",
  "type": "object",
  "required": ["schema_version", "estimator", "template_version", "status", "samples", "quality"],
  "properties": {
    "schema_version": {"const": "token-baseline/1.0"},
    "estimator": {"const": "deterministic-char-proxy/1"},
    "template_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["measured", "not_measured", "invalid"]},
    "samples": {"type": "array", "items": {"$ref": "#/$defs/sample"}},
    "quality": {
      "type": "object",
      "required": ["status", "reference", "reason"],
      "properties": {
        "status": {"enum": ["not_measured", "measured"]},
        "reference": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sample": {
      "type": "object",
      "required": ["id", "delivery_layer", "complexity", "round", "input_proxy_tokens", "output_proxy_tokens", "total_proxy_tokens", "actual_tokens"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "delivery_layer": {"enum": ["product", "implementation", "acceptance"]},
        "complexity": {"enum": ["small", "medium", "large"]},
        "round": {"type": "integer", "minimum": 1},
        "input_proxy_tokens": {"type": "integer", "minimum": 0},
        "output_proxy_tokens": {"type": "integer", "minimum": 0},
        "total_proxy_tokens": {"type": "integer", "minimum": 0},
        "actual_tokens": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    }
  }
}
